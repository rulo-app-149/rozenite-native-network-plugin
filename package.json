{
  "name": "rozenite-native-network-plugin",
  "version": "0.1.0",
  "description": "Rozenite (React Native DevTools) plugin that shows every HTTP request an app makes, including the ones issued by native code (OkHttp on Android, NSURLSession on iOS).",
  "license": "MIT",
  "keywords": [
    "rozenite",
    "rozenite-plugin",
    "react-native",
    "devtools",
    "network",
    "okhttp",
    "nsurlsession",
    "interceptor"
  ],
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "android",
    "!android/build",
    "ios",
    "*.podspec",
    "react-native.config.js",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/react-native/cjs/react-native.js",
  "module": "./dist/react-native/react-native.js",
  "types": "./dist/react-native/react-native.d.ts",
  "exports": {
    ".": {
      "types": "./dist/react-native/react-native.d.ts",
      "import": "./dist/react-native/react-native.js",
      "require": "./dist/react-native/cjs/react-native.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rozenite build",
    "dev": "rozenite dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run --passWithNoTests"
  },
  "dependencies": {
    "@rozenite/plugin-bridge": "^2.6.0"
  },
  "devDependencies": {
    "@rozenite/vite-plugin": "^2.6.0",
    "@types/react": "~19.1.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.2",
    "rozenite": "^2.6.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  }
}
